# Copy to .env — loaded automatically at startup. CLI flags win over these.
PORT=3000
HOST=0.0.0.0
LOG_LEVEL=info
# HTTPS=localhost,*.lo.example        # enable HTTPS with a self-signed cert for these names
# ANYTHING_DELAY=1
# ANYTHING_MAX_DELAY=600000
# COLORS_TITLE=Colors
# COLORS_DESCRIPTION=This is a colors plugin
# OIDC_ISSUER=https://idp.example.com/realms/demo
# OIDC_CLIENT_ID=fantocci
# OIDC_CLIENT_SECRET=change-me
# OIDC_DISCOVERY=https://idp.example.com/realms/demo/.well-known/openid-configuration
# OIDC_TOKEN_HEADER=x-auth-token
# FANTOCCI_CONFIG=./fantocci.yaml
