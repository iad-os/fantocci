{
  "name": "@iad-os/fantocci",
  "version": "1.0.0",
  "description": "Fantocci - an httpbin-inspired HTTP test server: request inspection, delays, status codes, fake OAuth2 introspection and OIDC token tools",
  "keywords": [
    "http",
    "testing",
    "httpbin",
    "mock",
    "oauth2",
    "oidc",
    "fastify"
  ],
  "homepage": "https://github.com/iad-os/fantocci#readme",
  "bugs": {
    "url": "https://github.com/iad-os/fantocci/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/iad-os/fantocci.git"
  },
  "license": "MIT",
  "contributors": [
    {
      "name": "Daniele Fiungo",
      "email": "daniele.fiungo@iad2.it"
    },
    {
      "name": "Irene La Bollita",
      "email": "irene.labollita@iad2.it"
    }
  ],
  "type": "module",
  "bin": {
    "fantocci": "./dist/cli.js"
  },
  "exports": {
    ".": {
      "types": "./dist/main.d.ts",
      "default": "./dist/main.js"
    }
  },
  "files": [
    "dist",
    "fantocci.schema.json"
  ],
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "tsx watch --inspect src/cli.ts | pino-pretty-compact",
    "start": "tsx src/cli.ts | pino-pretty-compact",
    "schema": "tsx src/cli.ts --schema fantocci.schema.json",
    "typecheck": "tsc --noEmit",
    "check": "biome ci .",
    "lint": "biome lint --write .",
    "format": "biome format --write .",
    "test": "vitest run",
    "test:watch": "vitest",
    "clean": "rimraf dist",
    "build": "rimraf dist && tsc -p tsconfig.build.json",
    "prepack": "npm run build"
  },
  "dependencies": {
    "@fastify/formbody": "^9.0.0",
    "@fastify/swagger": "^9.8.1",
    "@fastify/type-provider-typebox": "^6.1.0",
    "@ghii/ghii-v2": "^0.0.6",
    "@ghii/yaml-loader": "^1.1.0",
    "@scalar/fastify-api-reference": "^1.68.0",
    "fastify": "^5.12.4",
    "jwt-decode": "^4.0.0",
    "minimist": "^1.2.8",
    "mkcert": "^3.2.0",
    "nanoid": "^6.0.1",
    "openid-client": "^6.8.8",
    "typebox": "^1.3.31"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.13",
    "@mgcrea/pino-pretty-compact": "^1.6.0",
    "@tsconfig/node24": "^24.0.5",
    "@tsconfig/strictest": "^2.0.8",
    "@types/minimist": "^1.2.5",
    "@types/node": "^24.13.4",
    "rimraf": "^6.1.3",
    "tsx": "^4.23.13",
    "typescript": "^7.0.2",
    "vitest": "^5.0.0"
  }
}
